# Server Configuration
PORT=3000
NODE_ENV=development

# LLM Provider Configuration
# Supported providers: 'groq' (Recommended Free Tier), 'openai', or 'mock'
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b


OPENAI_API_KEY=sk-your_openai_key_here
OPENAI_MODEL=gpt-4o-mini

# Vector Database Configuration
# Options: 'memory' (Local Zero-Config), 'pinecone'
VECTOR_DB_TYPE=memory

# Pinecone (only required if VECTOR_DB_TYPE=pinecone)
# Sign up free at https://www.pinecone.io/
# IMPORTANT: Pinecone requires dense embeddings. Set EMBEDDING_PROVIDER=openai with Pinecone.
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=multidoc-rag

# Embedding Provider
# 'local' = free, zero-API-cost hashing embeddings (works with memory store)
# 'openai' = semantic-quality embeddings (required for Pinecone)
EMBEDDING_PROVIDER=local

# RAG Threshold & Search Options
# Use 0.20 for local embeddings, 0.60-0.75 for OpenAI embeddings
SIMILARITY_THRESHOLD=0.20
TOP_K=3

# Relational Database Configuration
DATABASE_URL=sqlite:///./rag_history.db
