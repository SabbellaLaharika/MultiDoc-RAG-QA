# Server Configuration
PORT=3000
NODE_ENV=development

# LLM Provider Configuration
# Supported providers: 'groq' (Recommended Free Tier), 'openai', or 'mock'
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

OPENAI_API_KEY=sk-your_openai_key_here
OPENAI_MODEL=gpt-4o-mini

# Vector Database Configuration
# Options: 'memory' (Local Zero-Config), 'pinecone', 'qdrant'
VECTOR_DB_TYPE=memory
VECTOR_DB_URL=https://your-vector-db-url.com
VECTOR_DB_API_KEY=your_vector_db_api_key

# RAG Threshold & Search Options
SIMILARITY_THRESHOLD=0.70
TOP_K=3

# Relational Database Configuration
DATABASE_URL=sqlite:///./rag_history.db
